annotation PBI_ProTooling = ["DevMode"]

ref table FACT_PRECIO
ref table DIM_ESTACION
ref table DIM_PRODUCTO
ref table DIM_FECHA
ref table DIM_HORA
ref table RESUMEN_ESTACION
