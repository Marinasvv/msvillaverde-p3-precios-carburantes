		isHidden
		formatString: 0
		lineageTag: 2d19187b-c7d2-4f5a-991c-db02e4283cfd
		summarizeBy: none
		sourceColumn: DIAS_CON_CAMBIOS

		annotation SummarizationSetBy = User

