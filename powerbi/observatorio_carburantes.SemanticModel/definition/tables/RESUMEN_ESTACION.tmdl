		isHidden
		lineageTag: aaad1a41-9940-4acf-9c64-ca1d5a7a832e
		summarizeBy: none
		sourceColumn: CAMBIA_TODOS_LOS_DIAS

	partition RESUMEN_ESTACION = m
		mode: import
		source =
				let
				    Origen = Snowflake.Databases(#"Servidor Snowflake", #"Warehouse Snowflake", [Role = "SYSADMIN", Implementation = "2.0"]),
				    BaseDatos = Origen{[Name = "CARBURANTES_DB", Kind = "Database"]}[Data],
				    Esquema = BaseDatos{[Name = "GOLD", Kind = "Schema"]}[Data],
				    Vista = Esquema{[Name = "V_PBI_RESUMEN_ESTACION", Kind = "View"]}[Data],
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(Vista, {{"STATION_SK", Int64.Type}, {"PRODUCT_SK", Int64.Type}, {"CAMBIOS", Int64.Type}, {"DIAS_CON_CAMBIOS", Int64.Type}})
				in
				    #"Tipo de columna cambiado"

	annotation PBI_ResultType = Table

