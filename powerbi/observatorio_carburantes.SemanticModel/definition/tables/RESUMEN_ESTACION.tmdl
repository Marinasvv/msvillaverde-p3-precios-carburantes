/// Actividad de cada estación y producto en todo el histórico (vista GOLD.v_pbi_resumen_estacion).
/// Se une a la versión vigente de la estación y no responde al filtro de fechas.
table RESUMEN_ESTACION
	lineageTag: a1e5465c-685d-47e1-aa49-a8108e21e84b

	column STATION_SK
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1b5c358e-e4a4-4746-ac02-d89502623774
		summarizeBy: none
		sourceColumn: STATION_SK

	column PRODUCT_SK
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: faf09290-aca0-4f79-b9d6-902a610dbe7d
		summarizeBy: none
		sourceColumn: PRODUCT_SK

	column 'Nº cambios'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2f9eb4b0-6ad0-4f45-bc37-7ca7a2b7f027
		summarizeBy: none
		sourceColumn: CAMBIOS

		annotation SummarizationSetBy = User

	column 'Días con cambios'
