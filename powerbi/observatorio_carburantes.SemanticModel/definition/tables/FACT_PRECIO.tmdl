	partition FACT_PRECIO = m
		mode: import
		source =
				let
				    Origen = Snowflake.Databases(#"Servidor Snowflake", #"Warehouse Snowflake", [Role = "SYSADMIN", Implementation = "2.0"]),
				    BaseDatos = Origen{[Name = "CARBURANTES_DB", Kind = "Database"]}[Data],
