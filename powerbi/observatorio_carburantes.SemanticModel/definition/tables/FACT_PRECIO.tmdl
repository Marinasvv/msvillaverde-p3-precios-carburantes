/// Un precio por estación, producto y captura de 3 horas (vista GOLD.v_pbi_fact_precio).
/// Las columnas numéricas están ocultas: se analizan con las medidas de la tabla Medidas.
table FACT_PRECIO
	lineageTag: a0234b82-8958-4ed4-b45b-1709cab223c8

	column STATION_SK
		dataType: int64
		isHidden
		formatString: 0
